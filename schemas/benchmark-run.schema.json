{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark run",
  "type": "object",
  "required": ["id", "manifest", "status", "created_at"],
  "properties": {
    "id": {"type": "string"},
    "manifest": {"$ref": "version-manifest.schema.json"},
    "status": {"enum": ["created", "running", "complete", "failed", "quarantined"]},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
