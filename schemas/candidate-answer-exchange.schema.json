{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imported candidate answer exchange row",
  "type": "object",
  "required": ["case_id", "case_version", "case_content_hash", "text"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "case_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "case_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "finish_reason": {"type": ["string", "null"]},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "token_usage": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}
