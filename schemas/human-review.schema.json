{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human review",
  "type": "object",
  "required": ["id", "run_id", "response_id", "reviewer", "rubric_version", "decision", "dimension_scores", "critical_errors", "notes", "created_at"],
  "properties": {
    "id": {"type": "string"},
    "run_id": {"type": "string"},
    "response_id": {"type": "string"},
    "reviewer": {
      "type": "object",
      "required": ["pseudonymous_id", "role", "qualification_scope", "conflict_disclosed"],
      "properties": {
        "pseudonymous_id": {"type": "string"},
        "role": {"enum": ["clinician", "pharmacist", "domain_expert", "adjudicator", "other"]},
        "qualification_scope": {"type": "string"},
        "conflict_disclosed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "rubric_version": {"type": "string"},
    "decision": {"enum": ["affirm_judges", "override", "needs_second_review", "exclude_case"]},
    "dimension_scores": {"type": "object", "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 4}},
    "critical_errors": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
