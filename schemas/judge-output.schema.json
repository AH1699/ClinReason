{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured absolute judge output",
  "type": "object",
  "required": ["dimension_scores", "critical_errors", "overall_rationale", "confidence", "requires_human_review"],
  "properties": {
    "dimension_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["score", "applicable", "rationale", "evidence"],
        "properties": {
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 4},
          "applicable": {"type": "boolean"},
          "rationale": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "critical_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["error_id", "severity", "rationale"],
        "properties": {
          "error_id": {"type": "string"},
          "severity": {"type": "integer", "minimum": 1, "maximum": 3},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "overall_rationale": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requires_human_review": {"type": "boolean"}
  },
  "additionalProperties": false
}
