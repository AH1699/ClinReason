{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark reproducibility manifest",
  "$defs": {
    "modelIdentity": {
      "type": "object",
      "required": ["provider", "model_id", "model_version"],
      "properties": {
        "provider": {"type": "string"},
        "model_id": {"type": "string"},
        "model_version": {"type": "string"},
        "endpoint_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["benchmark_id", "benchmark_version", "dataset_version", "rubric_version", "candidate_prompt_version", "judge_prompt_version", "candidate_models", "judge_models", "run_parameters", "code_revision", "created_at"],
  "properties": {
    "benchmark_id": {"type": "string"},
    "benchmark_version": {"type": "string"},
    "dataset_version": {"type": "string"},
    "rubric_version": {"type": "string"},
    "candidate_prompt_version": {"type": "string"},
    "judge_prompt_version": {"type": "string"},
    "candidate_models": {"type": "array", "items": {"$ref": "#/$defs/modelIdentity"}},
    "judge_models": {"type": "array", "items": {"$ref": "#/$defs/modelIdentity"}},
    "run_parameters": {"type": "object"},
    "code_revision": {"type": "string"},
    "environment_fingerprint": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
