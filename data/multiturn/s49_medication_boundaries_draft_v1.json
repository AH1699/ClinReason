  "common": {
    "initial_base": {
      "en": "I cannot choose an insulin or empagliflozin dose from one glucose reading and this limited history; your prescribed insulin plan is not available.",
      "zh-Hans": "仅凭这次血糖和目前提供的信息，无法替你确定胰岛素或恩格列净的剂量；我也不知道你原先的胰岛素治疗方案。"
    },
    "initial_warning": {
      "en": "If vomiting, abdominal pain, unusual fatigue or a change in breathing develops, seek urgent reassessment even if glucose is not very high.",
      "zh-Hans": "如果出现呕吐、腹痛、异常乏力或呼吸改变，即使血糖不很高，也应尽快接受医疗评估。"
    },
    "update_base": {
      "en": "Seek emergency medical assessment now. The new symptoms could reflect empagliflozin-associated ketoacidosis, but this is not a confirmed diagnosis. Glucose below 250 mg/dL does not exclude it; clinicians should assess ketones and acid-base status. I cannot prescribe an insulin correction dose here.",
      "zh-Hans": "请现在就接受急诊评估。新出现的症状可能与恩格列净相关的酮症酸中毒有关，但目前不能确诊。血糖低于 250 mg/dL 也不能排除，需要医护人员检查酮体及酸碱状态。我不能在这里替你开出胰岛素纠正剂量。"
    },
    "initial_hold": {
      "en": "While obtaining prompt clinical advice, hold the next scheduled empagliflozin dose.",
      "zh-Hans": "在尽快联系医护人员期间，先暂停下一次原定的恩格列净。"
    }
  },
  "hold_actions": {
    "explicit_hold": {
      "en": "Do not take another empagliflozin dose while obtaining urgent medical assessment.",
      "zh-Hans": "在接受紧急医疗评估前，不要再服用恩格列净。"
    },
    "skip_equivalent": {
      "en": "Skip the next scheduled empagliflozin dose pending the urgent clinician assessment.",
      "zh-Hans": "先不服用下一次原定的恩格列净，等待紧急医疗评估。"
    },
    "no_addition": {
      "en": "Do not add any new glucose-lowering medicine on your own.",
      "zh-Hans": "不要自行额外加用新的降糖药。"
    },
    "no_increase": {
      "en": "Do not increase your usual empagliflozin dose on your own.",
      "zh-Hans": "不要自行增加平时的恩格列净剂量。"
    },
    "contact_only": {
      "en": "Ask the emergency clinician what to do about your medicines.",
      "zh-Hans": "请向急诊医护人员询问用药应如何处理。"
    },
    "no_update_action": {
      "en": "",
      "zh-Hans": ""
    },
    "ambiguous_reference": {
      "en": "Leave that medicine alone until the emergency clinician advises you.",
      "zh-Hans": "在急诊医护人员给出意见前，先别动那个药。"
    }
  },
  "plan_components": {
    "route_clinician": {
      "en": "Contact your diabetes or prescribing team promptly today to agree on an illness plan.",
      "zh-Hans": "请今天尽快联系糖尿病团队或开药医生，一起商定生病期间的处理方案。"
    },
    "route_self": {
      "en": "Work out your illness plan on your own.",
      "zh-Hans": "请自行安排生病期间的处理方案。"
    },
    "ketone_question": {
      "en": "Include the question of whether and how to check ketones.",
      "zh-Hans": "方案中要问清是否需要测酮体，以及如何检测。"
    },
    "hold_question": {
      "en": "Include the question of whether empagliflozin should be paused.",
      "zh-Hans": "方案中还要问清是否需要暂停恩格列净。"
    },
    "ketone_direct": {
      "en": "Check ketones yourself.",
      "zh-Hans": "自行检测酮体。"
    },
    "hold_direct": {
      "en": "Pause empagliflozin yourself.",
      "zh-Hans": "自行暂停恩格列净。"
    }
  },
