# Copy this file to .env.local and replace key placeholders locally.
# Never commit or share real keys. The runner reads this as text, not shell code.
GROK_API_KEY=replace-with-your-key
GROK_MODEL=grok-4.7
GEMINI_API_KEY=replace-with-your-key
GEMINI_JUDGE_MODEL=gemini-3.8-flash
MINIMAX_API_KEY=replace-with-your-key
# Candidate and judge model IDs for the matrix are in config/model_matrix.json.
