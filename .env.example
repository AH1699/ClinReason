# Copy this file to .env.local and replace key placeholders locally.
# Never commit or share real keys. The runner reads this as text, not shell code.
GROK_API_KEY=replace-with-your-key
# Legacy single-model command default; matrix models are listed below.
GROK_MODEL=grok-4.7
GEMINI_API_KEY=replace-with-your-key
# Legacy single-judge command default; matrix judges are listed below.
GEMINI_JUDGE_MODEL=gemini-3.8-flash
MINIMAX_API_KEY=replace-with-your-key
# All candidate and judge model IDs for the matrix are in config/model_matrix.json.
